# Read docs/DEPLOYMENT.md before enabling live mode.
# Local default: no secrets -> clearly labelled browser-only interactive demo.

# Required together for a SINGLE-ORGANIZATION live pilot:
DATABASE_URL=
# For Quorail v1, use a DIRECT PostgreSQL URL (session-level advisory locks).
# Do not use a transaction-pooler URL unless the locking model is upgraded.

ADMIN_PASSWORD=
SESSION_SECRET=

# Real model reasoning: required for autonomous execution (rules-only is analysis only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Arc testnet. The contract must be deployed and funded before the agent can move USDC.
ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_VAULT_ADDRESS=
VAULT_ADDRESS=
AGENT_PRIVATE_KEY=

# Owner/deployer key only on your LOCAL machine for the deployment script. Never set on Vercel.
DEPLOYER_PRIVATE_KEY=
SINGLE_LIMIT_USDC=200
AUTONOMOUS_LIMIT_USDC=50
DAILY_LIMIT_USDC=400

# Optional protected scheduler endpoint. Use a long random string, NOT your login password.
CRON_SECRET=

# Optional Circle App Kit CCTP bridge from Ethereum Sepolia to Arc Testnet
BRIDGE_PRIVATE_KEY=
BRIDGE_AMOUNT_USDC=
